      "questions": [
        {
          "text": "What does he need to hear?",
          "answers": [
            { "chapterId": "ambition", "label": "The truth about what he's chasing" },
            { "chapterId": "love", "label": "That someone is still here" },
            { "chapterId": "acceptance", "label": "That it's already enough" }
