  "_comments": {
    "trackIndexFormula": "songIndex * 12 + layerIndex * 2 + optionOffset. With 6 layers: Song 0 = tracks 0-11, Song 1 = tracks 12-23, Song 2 = tracks 24-35. Option A = even index, Option B = odd index.",
    "layerOrdering": "Layers are staggered across songs so different types unlock first. Song 1 (ambition): bass/drums/melody/harmony/pad/fx. Song 2 (love): melody/harmony/fx/bass/pad/drums. Song 3 (avoidance): pad/fx/drums/bass/melody/harmony.",
    "thresholds": "Per-layer doubt thresholds. winningProportion must meet or exceed threshold to pass. Layer 0-1: 0.50 (any majority passes). Layer 5: 0.95 (near-perfect alignment required).",
    "tempos": "Per-layer BPM. Increases each layer to create urgency. Layer 0: 120 BPM (relaxed), Layer 5: 170 BPM (desperate).",
    "auditionBars": "Bars per option per cycle (A and B each get this many bars per cycle). Total voting window = auditionBars * 2 * auditionCycles * barsToMs(1, tempo).",
    "auditionCycles": "Number of A-B cycles per layer. 1 = A then B (default). 2 = A-B-A-B. Each cycle plays option A for auditionBars bars, then option B for auditionBars bars.",
    "audioReferences": "trackIndex values follow the formula above. clipSlot is 0-indexed. Replace with actual Ableton layout.",
    "optionLabels": "Emotional taglines are placeholders. Replace with labels that match actual musical content.",
    "collapseReturnTrackIndex": "The Ableton return track index for collapse effects is configured in config/ableton-layout.json."
  }
