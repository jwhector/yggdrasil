        },
        {
          "text": "What does he owe himself?",
          "answers": [
            { "chapterId": "ambition", "label": "The chance to prove it" },
            { "chapterId": "love", "label": "The grace to be held" },
            { "chapterId": "acceptance", "label": "The permission to rest" }
          ]
        },
        {
          "text": "What is he afraid to say?",
          "answers": [
            { "chapterId": "ambition", "label": "That he doesn't know the way" },
            { "chapterId": "love", "label": "That he needs someone" },
            { "chapterId": "acceptance", "label": "That he's tired of fighting" }
          ]
        },
        {
          "text": "What would it sound like if he forgave himself?",
          "answers": [
            { "chapterId": "ambition", "label": "A deep breath before starting again" },
            { "chapterId": "love", "label": "A voice saying 'I'm still here'" },
            { "chapterId": "acceptance", "label": "Silence, finally at peace" }
          ]
        },
        {
          "text": "What part of him is still waiting?",
          "answers": [
            { "chapterId": "ambition", "label": "The part that never got its shot" },
            { "chapterId": "love", "label": "The part that learned to hide" },
            { "chapterId": "acceptance", "label": "The part that forgot how to stop" }
          ]
        },
        {
          "text": "What does the silence sound like?",
          "answers": [
            { "chapterId": "ambition", "label": "An engine waiting to ignite" },
            { "chapterId": "love", "label": "A room where someone just left" },
            { "chapterId": "acceptance", "label": "Snow falling on still water" }
          ]
        },
        {
          "text": "What would he build if failure didn't exist?",
          "answers": [
            { "chapterId": "ambition", "label": "Something the world remembers" },
            { "chapterId": "love", "label": "A place where no one leaves" },
            { "chapterId": "acceptance", "label": "Nothing — just being would be enough" }
          ]
        },
        {
          "text": "What does he hear when no one is listening?",
          "answers": [
            { "chapterId": "ambition", "label": "A drumbeat pushing forward" },
            { "chapterId": "love", "label": "An echo of every goodbye" },
            { "chapterId": "acceptance", "label": "His own voice, finally honest" }
